# OpenAI (server-side only). OPENAI_MODEL defaults to gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Or use any OpenAI-compatible endpoint from the event credits.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Parallel (https://docs.parallel.ai)
PARALLEL_API_KEY=

# Composio (later step: host emails and LinkedIn posts). Not needed for the first demo.
# COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=harvey

# Leave unset to run on mock data. Every route falls back to mocks when its keys are missing.
