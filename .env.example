# Model sides. Fill in either or both; the preferred one is tried first and the other is the fallback,
# then mocks. Keeping Cline and OpenAI separate means one running dry doesn't stop the demo.
LLM_PROVIDER=cline            # default side for every feature: cline | openai | custom
DAILY_LLM_PROVIDER=           # optional per-feature override for Nomi Daily
BOTS_LLM_PROVIDER=            # optional per-feature override for Nomi Bots (pass it as chat({ provider }))

# Cline credits (key from app.cline.bot > Settings > API Keys)
CLINE_API_KEY=
CLINE_MODEL=                  # default anthropic/claude-opus-5.5 (strongest); empty is fine
CLINE_FALLBACK_MODEL=         # default anthropic/claude-sonnet-5.5, tried if the first model fails or is slow

# OpenAI, or any OpenAI-compatible host via OPENAI_BASE_URL
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Custom side (the original setup, e.g. the event's open-model credits)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Parallel (https://docs.parallel.ai). Nomi Bots scout live events, people and communities with it.
# For a live demo: set this plus CLINE_API_KEY, open Nomi Bots once on good wifi to fill the scout cache
# (userData/nomi-live-cache.json); if the venue network drops, the bots fall back to those saved results.
PARALLEL_API_KEY=

# Composio (later step: host emails and LinkedIn posts). Not needed for the first demo.
# COMPOSIO_API_KEY=
# COMPOSIO_USER_ID=harvey

# Leave unset to run on mock data. Every route falls back to mocks when its keys are missing.

# Voice check-in transcription. Uses OPENAI_API_KEY when set, else Whisper on the Mac (run `npm run voice:setup`
# once; WHISPER_MODEL overrides the model path, default ~/.nomi/ggml-base.en.bin).
TRANSCRIBE_MODEL=whisper-1
WHISPER_MODEL=

# On a Mac, Nomi reads your real Apple Calendar. Each calendar takes about a second, so list the ones to read
# (comma-separated) to keep Today quick. Set NOMI_DEMO_CALENDAR=1 to use the demo feed instead.
NOMI_CALENDARS="Nomi Demo"
NOMI_DEMO_CALENDAR=
