{
  "name": "nomi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && concurrently -k -n vite,main,app \"vite build --watch\" \"npm:build:main -- --watch\" \"electron .\"",
    "build": "vite build && npm run build:main",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --log-level=warning",
    "start": "electron .",
    "desktop": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "voice:setup": "bash scripts/setup-voice.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "electron": "^38.8.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7"
  },
  "main": "dist-electron/main.js"
}
